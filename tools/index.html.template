<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DSH Plugins — DeepSeek Harness 插件精选</title>
<meta name="description" content="浏览 DeepSeek Harness (DSH) 社区精选插件：178 个插件、9 大分类，支持搜索、筛选与排序。">
<style>
  :root {
    --bg: #0a0f1f;
    --bg2: #0e1528;
    --bg3: #131b33;
    --line: rgba(148, 163, 219, 0.14);
    --blue: #4d6bfe;
    --blue2: #6e8bff;
    --text: #e7ebf7;
    --muted: #93a0c4;
    --dim: #5d6a92;
    --gold: #e3b341;
    --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { color-scheme: dark; }
  body {
    background: radial-gradient(1200px 600px at 70% -10%, rgba(77, 107, 254, 0.16), transparent 60%), var(--bg);
    color: var(--text);
    font-family: var(--sans);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }

  /* header */
  header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(10, 15, 31, 0.82);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .hd { display: flex; align-items: center; justify-content: space-between; gap: 16px; max-width: 900px; margin: 0 auto; padding: 0 20px; height: 54px; }
  .brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .brand .whale { flex-shrink: 0; }
  .brand .name { font-weight: 600; letter-spacing: -0.01em; font-size: 16px; white-space: nowrap; }
  .brand .name b { color: var(--blue2); }
  .brand .tag { font-size: 11px; color: var(--dim); font-family: var(--mono); white-space: nowrap; }
  nav { display: flex; align-items: center; gap: 16px; }
  nav a { font-size: 13px; color: var(--muted); transition: color .15s; white-space: nowrap; }
  nav a:hover { color: var(--text); }

  main { max-width: 900px; margin: 0 auto; padding: 36px 20px 80px; }

  /* breadcrumb */
  .crumb { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--dim); margin-bottom: 22px; font-family: var(--mono); }
  .crumb a:hover { color: var(--blue2); }
  .crumb .sep { opacity: .6; }

  /* hero */
  .hero { display: flex; align-items: center; gap: 28px; margin-bottom: 26px; }
  .hero .txt { flex: 1; min-width: 0; }
  .hero h1 { font-size: 34px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin-bottom: 10px; }
  .hero h1 .accent { color: var(--blue2); }
  .hero .sub { color: var(--muted); font-size: 14.5px; line-height: 1.6; }
  .hero .whale-wrap { flex-shrink: 0; }
  .hero .whale-wrap svg { display: block; filter: drop-shadow(0 8px 24px rgba(77, 107, 254, 0.35)); animation: bob 5s ease-in-out infinite; }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

  /* stats */
  .stats { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 26px; }
  .stat {
    display: inline-flex; align-items: center; gap: 7px;
    border: 1px solid var(--line); background: var(--bg2);
    border-radius: 999px; padding: 6px 14px; font-size: 12.5px; color: var(--muted);
  }
  .stat b { color: var(--text); font-family: var(--mono); font-weight: 600; }
  .stat .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue); }
  .stat.live b { color: #7ee2a8; }
  .stat.live .dot { background: #7ee2a8; }

  /* search */
  .search { position: relative; margin-bottom: 14px; }
  .search input {
    width: 100%; padding: 13px 18px 13px 44px;
    border-radius: 12px; border: 1px solid var(--line);
    background: var(--bg2); color: var(--text); font-size: 15px; outline: none;
    transition: border-color .15s, box-shadow .15s;
  }
  .search input::placeholder { color: var(--dim); }
  .search input:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(77, 107, 254, 0.25); }
  .search .icon { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: var(--dim); pointer-events: none; }

  /* controls */
  .controls { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .chip {
    border: 1px solid var(--line); background: transparent; color: var(--muted);
    border-radius: 999px; padding: 5px 13px; font-size: 12.5px; cursor: pointer;
    font-family: var(--sans); transition: all .15s; white-space: nowrap;
  }
  .chip:hover { color: var(--text); border-color: var(--blue2); }
  .chip.on { background: var(--blue); border-color: var(--blue); color: #fff; }
  .chip .n { font-family: var(--mono); font-size: 11px; opacity: .75; margin-left: 2px; }
  .sort { display: flex; align-items: center; gap: 4px; font-family: var(--mono); }
  .sort button {
    background: transparent; border: 1px solid transparent; color: var(--dim);
    font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .04em;
    padding: 5px 10px; border-radius: 8px; cursor: pointer; transition: all .15s;
  }
  .sort button:hover { color: var(--text); }
  .sort button.on { color: var(--blue2); background: rgba(77, 107, 254, 0.12); }

  /* view tabs */
  .views { display: inline-flex; gap: 4px; border: 1px solid var(--line); border-radius: 10px; padding: 3px; margin-bottom: 14px; background: var(--bg2); }
  .views .view { border: none; background: transparent; color: var(--muted); font-size: 13px; padding: 6px 18px; border-radius: 8px; cursor: pointer; font-family: var(--sans); transition: all .15s; }
  .views .view:hover { color: var(--text); }
  .views .view.on { background: var(--blue); color: #fff; }

  /* keyword map / tag cloud */
  .kwbar { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px; }
  .kwlabel { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); padding-top: 8px; white-space: nowrap; }
  .kwcloud { display: flex; flex-wrap: wrap; gap: 6px; flex: 1; }
  .kwt {
    border: 1px solid var(--line); background: rgba(77, 107, 254, 0.06); color: var(--muted);
    border-radius: 999px; padding: 3px 11px; font-size: 12px; cursor: pointer; transition: all .15s; line-height: 1.3;
  }
  .kwt:hover { color: var(--text); border-color: var(--blue2); }
  .kwt.on { background: var(--blue); border-color: var(--blue); color: #fff; }
  .kwt .n { font-family: var(--mono); font-size: 10px; opacity: .7; margin-left: 3px; }

  /* row keyword chips */
  .row .kw { display: inline-block; font-size: 10px; font-family: var(--mono); color: var(--dim); border: 1px solid var(--line); border-radius: 999px; padding: 0 6px; margin-top: 5px; margin-right: 4px; }

  /* leaderboard */
  .board { display: flex; flex-direction: column; }
  .brow {
    display: grid; grid-template-columns: 44px 1fr auto; gap: 12px; align-items: center;
    padding: 12px 14px; border-bottom: 1px solid var(--line); border-radius: 8px; margin: 0 -6px; padding-left: 20px; padding-right: 20px;
    transition: background .12s;
  }
  .brow:hover { background: rgba(77, 107, 254, 0.10); }
  .brow .rank { font-family: var(--mono); font-size: 15px; color: var(--dim); text-align: center; }
  .brow .rank.g1 { color: #ffd75e; }
  .brow .rank.g2 { color: #c8d2e8; }
  .brow .rank.g3 { color: #e0a06b; }
  .brow .bl { min-width: 0; }
  .brow .bl .nm { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .brow .bl .nm .t { font-weight: 600; font-size: 14px; }
  .brow:hover .bl .nm .t { color: var(--blue2); }
  .brow .bl .meta { font-size: 11.5px; color: var(--dim); margin-top: 3px; }
  .brow .bl .meta .cat { color: var(--muted); }
  .brow .br { font-family: var(--mono); font-size: 14px; color: var(--gold); white-space: nowrap; }

  /* list */
  .thead {
    display: grid; grid-template-columns: 1fr auto;
    gap: 12px; padding: 8px 14px; border-bottom: 1px solid var(--line);
    font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim);
  }
  .list { display: flex; flex-direction: column; }
  .row {
    display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: start;
    padding: 13px 14px; border-bottom: 1px solid var(--line);
    transition: background .12s; border-radius: 8px; margin: 0 -6px; padding-left: 20px; padding-right: 20px;
  }
  .row:hover { background: rgba(77, 107, 254, 0.10); }
  .row .l { min-width: 0; }
  .row .nm { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .row .nm .t { font-weight: 600; font-size: 14.5px; letter-spacing: -0.01em; }
  .row:hover .nm .t { color: var(--blue2); }
  .row .nm .lang { font-family: var(--mono); font-size: 10.5px; color: var(--dim); border: 1px solid var(--line); padding: 1px 7px; border-radius: 999px; }
  .row .nm .owner { font-family: var(--mono); font-size: 10.5px; color: var(--dim); }
  .row .d { color: var(--muted); font-size: 12.5px; line-height: 1.55; margin-top: 4px; }
  .row .r { text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
  .row .stars { font-family: var(--mono); font-size: 13px; color: var(--gold); white-space: nowrap; }
  .row .stars .u { color: var(--dim); font-size: 10.5px; margin-left: 2px; }
  .empty { color: var(--dim); text-align: center; padding: 48px 0; font-size: 14px; }

  footer { border-top: 1px solid var(--line); margin-top: 40px; padding: 26px 20px; text-align: center; color: var(--dim); font-size: 12.5px; line-height: 1.9; }
  footer a { color: var(--muted); }
  footer a:hover { color: var(--blue2); }
  footer code { font-family: var(--mono); font-size: 11.5px; background: var(--bg2); border: 1px solid var(--line); padding: 2px 8px; border-radius: 6px; color: var(--muted); }

  @media (max-width: 640px) {
    .hero { flex-direction: column; align-items: flex-start; gap: 14px; }
    .hero h1 { font-size: 27px; }
    .brand .tag { display: none; }
    .thead { display: none; }
    .row { grid-template-columns: 1fr; }
    .row .r { flex-direction: row; align-items: center; }
  }
</style>
</head>
<body>

<header>
  <div class="hd">
    <div class="brand">
      <span class="whale" id="miniWhale"></span>
      <span class="name">dsh-plugins<b>.top</b></span>
      <span class="tag">deepseek-harness · curated</span>
    </div>
    <nav>
      <a href="https://github.com/xiaohai-78/Top" target="_blank" rel="noreferrer">Top 榜单</a>
      <a href="https://github.com/0xsline/awesome-deepseek-harness" target="_blank" rel="noreferrer">Awesome 参考</a>
      <a href="https://github.com" target="_blank" rel="noreferrer">GitHub</a>
    </nav>
  </div>
</header>

<main>
  <div class="crumb">
    <a href="/">dsh-plugins.top</a><span class="sep">/</span><span>plugins</span>
  </div>

  <div class="hero">
    <div class="txt">
      <h1>DeepSeek Harness<br><span class="accent">插件精选</span></h1>
      <div class="sub">浏览 dsh-external 社区的精选 DSH 插件 —— Web UI、记忆与上下文、工具集、Agent 工作流、桌面与远程、浏览器与消息通道……点击任意插件直达 GitHub。</div>
    </div>
    <div class="whale-wrap" id="heroWhale"></div>
  </div>

  <div class="stats" id="stats"></div>

  <div class="views">
    <button class="view on" data-view="browse">浏览</button>
    <button class="view" data-view="board">排行榜</button>
  </div>

  <div class="search" id="searchWrap">
    <svg class="icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="7" cy="7" r="4.5"/><path d="m10.5 10.5 3 3"/></svg>
    <input id="q" type="search" placeholder="搜索插件名 / 描述 / 关键词，例如 memory、sidebar、工具、视觉…" autocomplete="off">
  </div>

  <div class="kwbar" id="kwbar">
    <span class="kwlabel">关键词地图</span>
    <div class="kwcloud" id="kwcloud"></div>
  </div>

  <div class="controls">
    <div class="chips" id="chips"></div>
    <div class="sort">
      <button data-sort="stars" class="on">Stars ↓</button>
      <button data-sort="starsAsc">Stars ↑</button>
      <button data-sort="name">A–Z</button>
    </div>
  </div>

  <div class="thead" id="thead"><span>Plugin</span><span>Stars / Lang</span></div>
  <div class="list" id="list"></div>
  <div class="board" id="board" hidden></div>
  <div class="empty" id="empty" hidden>没有匹配的插件，换个关键词试试 🐋</div>
</main>

<footer>
  <div><b style="color:var(--text)">dsh-plugins.top</b> — DeepSeek Harness 插件精选站 · 数据来自 <a href="https://github.com/xiaohai-78/Top" target="_blank" rel="noreferrer">xiaohai-78/Top</a>（dsh-external 生态每日榜单）· 布局灵感来自 <a href="https://www.skills.sh/vercel" target="_blank" rel="noreferrer">skills.sh</a></div>
  <div>官方安装方式：<code>dsh plugin --profile web add "github:&lt;owner&gt;/&lt;repo&gt;#main"</code>（需该仓库可访问）</div>
  <div>🐋 官方 DeepSeek logo 拼豆版 · 蓝 #4D6BFE · 每日自动同步 Top 榜单 + 自动发现 dsh-plugin topic</div>
</footer>

<script>
/*__AWESOME_DATA__*/
</script>
<script>
(function () {
  'use strict';

  // ---- pixel bead whale (拼豆) map: official DeepSeek logo rasterized ----
    var WHALE_MAP = [
    '................................',
    '................................',
    '................................',
    '................................',
    '......................M.........',
    '.............MBBB....MB.........',
    '.....MBBBBBBBBBB.....BBB......MM',
    '....BBBBBBBBBBBB.....BBBBM..MMBM',
    '...BBBBBBBBBBBBBBM...BBBBBBBBBBM',
    '..BBBBBBBBBBBBBBBBM..MBBBBBBBBB.',
    '..BBBBBBBBBBBBBBBBBM..BBBBBBBBM.',
    '.BBBBBBBBBBBBBBBBBBBM..BBBBBBM..',
    '.BBBBBBBBBBBBBBBBBBBBM.MBBBM....',
    'MBB....MBBBBBBBBBBBBBBBBBBB.....',
    'MBB......MBBBBBBBM.BBBBBBBM.....',
    'MBB........BBBBBBBM.BBBBBBM.....',
    'MBB.........BBBBBBM..BBBBB......',
    '.BBM.........BBBBBB..BBBBB......',
    '.BBB..........BBBBBBBBBBBM......',
    '.BBBM.........MBBBBBBBBBB.......',
    '.MBBB..........BBBBBBBBBM.......',
    '..BBBB.....M....BBBBBBBB........',
    '...BBBB...MBBM..MBBBBBB.........',
    '...MBBBB...BBBB..MBBBBBM........',
    '....MBBBBBBBBBBBM.MBBBBBB.......',
    '......BBBBBBBBBBBBBBMBBBM.......',
    '.......MBBBBBBBBBBM.............',
    '.........MMBBBBMM...............',
    '................................',
    '................................',
    '................................',
    '................................',
  ];
  var BEADS = {
    B: '#4d6bfe',
    M: '#7c8cff',
    C: '#afc0ff',
    W: '#ffffff',
    S: '#9fd8ff',
    T: '#5b74ff'
  };

  function whaleSvg(px) {
    var rows = WHALE_MAP.length, cols = WHALE_MAP[0].length;
    var cell = px / cols;
    var gap = Math.max(1, cell * 0.08);
    var r = cell * 0.22;
    var s = cell - gap * 2;
    var rects = '';
    for (var y = 0; y < rows; y++) {
      for (var x = 0; x < cols; x++) {
        var ch = WHALE_MAP[y][x];
        if (ch === '.' || !BEADS[ch]) continue;
        var cx = x * cell + gap, cy = y * cell + gap;
        rects += '<rect x="' + cx.toFixed(2) + '" y="' + cy.toFixed(2) + '" width="' + s.toFixed(2) + '" height="' + s.toFixed(2) + '" rx="' + r.toFixed(2) + '" fill="' + BEADS[ch] + '"/>';
      }
    }
    return '<svg viewBox="0 0 ' + px + ' ' + (rows / cols * px).toFixed(1) + '" width="' + px + '" height="' + (rows / cols * px).toFixed(1) + '" xmlns="http://www.w3.org/2000/svg">' + rects + '</svg>';
  }

  document.getElementById('miniWhale').innerHTML = whaleSvg(30);
  document.getElementById('heroWhale').innerHTML = whaleSvg(230);

  // ---- data & state ----
  var DATA = window.AWESOME;
  var cats = Object.keys(DATA.cats);
  var all = [];
  cats.forEach(function (cn) {
    DATA.cats[cn].forEach(function (it) { it.cat = cn; all.push(it); });
  });
  var totalStars = all.reduce(function (n, it) { return n + it.s; }, 0);

  var state = { cat: '__all__', q: '', kw: '', sort: 'stars', view: 'browse' };

  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function kwArr(it) {
    var k = it && it.k;
    if (Array.isArray(k)) return k;
    if (typeof k === 'string') return [k];
    return [];
  }

  // ---- stats ----
  var statsEl = document.getElementById('stats');
  function renderStats(live) {
    var html = '';
    html += '<span class="stat"><span class="dot"></span><b>' + all.length + '</b> plugins</span>';
    html += '<span class="stat"><span class="dot"></span><b>' + cats.length + '</b> 分类</span>';
    html += '<span class="stat"><span class="dot"></span><b>⭐ ' + totalStars + '</b> total</span>';
    html += '<span class="stat"><span class="dot"></span><b>' + DATA.gen + '</b> 数据快照</span>';
    if (live) html += '<span class="stat live"><span class="dot"></span><b>已同步</b> 今日数据</span>';
    statsEl.innerHTML = html;
  }
  renderStats(false);

  // ---- chips ----
  var chipsEl = document.getElementById('chips');
  function renderChips() {
    var html = '<button class="chip' + (state.cat === '__all__' ? ' on' : '') + '" data-cat="__all__">全部<span class="n">' + all.length + '</span></button>';
    cats.forEach(function (cn) {
      html += '<button class="chip' + (state.cat === cn ? ' on' : '') + '" data-cat="' + esc(cn) + '">' + esc(cn) + '<span class="n">' + DATA.cats[cn].length + '</span></button>';
    });
    chipsEl.innerHTML = html;
  }
  renderChips();
  chipsEl.addEventListener('click', function (e) {
    var b = e.target.closest('.chip');
    if (!b) return;
    state.cat = b.getAttribute('data-cat');
    renderChips(); renderList();
  });

  // ---- keyword map (tag cloud) ----
  var kwCloudEl = document.getElementById('kwcloud');
  var kwCounts = {};
  all.forEach(function (it) {
    kwArr(it).forEach(function (kw) { kwCounts[kw] = (kwCounts[kw] || 0) + 1; });
  });
  var kwTop = Object.keys(kwCounts).sort(function (a, b) { return kwCounts[b] - kwCounts[a]; }).slice(0, 24);
  var kwMax = kwTop.length ? kwCounts[kwTop[0]] : 1;
  function renderKwCloud() {
    var html = '';
    kwTop.forEach(function (kw) {
      var size = 11 + Math.round(6 * kwCounts[kw] / kwMax);
      html += '<button class="kwt' + (state.kw === kw ? ' on' : '') + '" data-kw="' + esc(kw) + '" style="font-size:' + size + 'px">' + esc(kw) + '<span class="n">' + kwCounts[kw] + '</span></button>';
    });
    if (state.kw) html += '<button class="kwt on" data-kw="">✕ 清除</button>';
    kwCloudEl.innerHTML = html;
  }
  kwCloudEl.addEventListener('click', function (e) {
    var b = e.target.closest('.kwt');
    if (!b) return;
    state.kw = b.getAttribute('data-kw');
    state.view = 'browse';
    renderKwCloud(); renderViews(); renderList();
  });
  renderKwCloud();

  // ---- view tabs ----
  var boardEl = document.getElementById('board');
  var theadEl = document.getElementById('thead');
  var listEl = document.getElementById('list');
  function renderViews() {
    var on = state.view === 'board';
    document.querySelectorAll('.views .view').forEach(function (x) {
      x.classList.toggle('on', x.getAttribute('data-view') === state.view);
    });
    boardEl.hidden = !on;
    theadEl.hidden = on;
    listEl.hidden = on;
    document.getElementById('searchWrap').style.display = on ? 'none' : '';
    document.querySelector('.kwbar').style.display = on ? 'none' : '';
    document.querySelector('.controls').style.display = on ? 'none' : '';
  }
  document.querySelector('.views').addEventListener('click', function (e) {
    var b = e.target.closest('.view');
    if (!b) return;
    state.view = b.getAttribute('data-view');
    renderViews();
    if (state.view === 'board') renderBoard();
  });
  renderViews();

  // ---- leaderboard ----
  function renderBoard() {
    var rows = all.slice().sort(function (a, b) { return b.s - a.s; }).slice(0, 50);
    var html = '';
    rows.forEach(function (it, i) {
      var rank = i + 1;
      var cls = rank === 1 ? 'g1' : (rank === 2 ? 'g2' : (rank === 3 ? 'g3' : ''));
      var medal = rank === 1 ? '🥇' : (rank === 2 ? '🥈' : (rank === 3 ? '🥉' : rank));
      var url = it.u || ('https://github.com/dsh-external/' + encodeURIComponent(it.n));
      html += '<a class="brow" href="' + url + '" target="_blank" rel="noreferrer">';
      html += '<span class="rank ' + cls + '">' + medal + '</span>';
      html += '<div class="bl"><div class="nm"><span class="t">' + esc(it.n) + '</span>';
      if (it.l) html += '<span class="lang">' + esc(it.l) + '</span>';
      html += '</div><div class="meta"><span class="cat">' + esc(it.cat) + '</span>' + (it.o ? ' · by ' + esc(it.o) : '') + '</div></div>';
      html += '<span class="br">⭐ ' + it.s + '</span>';
      html += '</a>';
    });
    boardEl.innerHTML = html;
  }

  // ---- sort ----
  document.querySelector('.sort').addEventListener('click', function (e) {
    var b = e.target.closest('button');
    if (!b) return;
    state.sort = b.getAttribute('data-sort');
    document.querySelectorAll('.sort button').forEach(function (x) { x.classList.toggle('on', x === b); });
    renderList();
  });

  // ---- search ----
  document.getElementById('q').addEventListener('input', function (e) {
    state.q = e.target.value.trim().toLowerCase();
    renderList();
  });

  // ---- list ----
  var emptyEl = document.getElementById('empty');
  function renderList() {
    var q = state.q;
    var items = all.filter(function (it) {
      if (state.cat !== '__all__' && it.cat !== state.cat) return false;
      if (state.kw && kwArr(it).indexOf(state.kw) === -1) return false;
      if (!q) return true;
      var hay = (it.n + ' ' + String(it.d || '')).toLowerCase();
      return hay.indexOf(q) !== -1 || kwArr(it).some(function (k) { return k.toLowerCase().indexOf(q) !== -1; });
    });
    items.sort(function (a, b) {
      if (state.sort === 'stars') return b.s - a.s;
      if (state.sort === 'starsAsc') return a.s - b.s;
      return (a.n.toLowerCase() < b.n.toLowerCase() ? -1 : 1);
    });
    emptyEl.hidden = items.length !== 0;
    var html = '';
    items.forEach(function (it) {
      var url = it.u || ('https://github.com/dsh-external/' + encodeURIComponent(it.n));
      html += '<a class="row" href="' + url + '" target="_blank" rel="noreferrer">';
      html += '<div class="l">';
      html += '<div class="nm"><span class="t">' + esc(it.n) + '</span>';
      if (it.o) html += '<span class="owner">by ' + esc(it.o) + '</span>';
      if (it.l) html += '<span class="lang">' + esc(it.l) + '</span>';
      html += '</div>';
      if (it.d) html += '<div class="d">' + esc(it.d) + '</div>';
      kwArr(it).slice(0, 3).forEach(function (kw) {
        html += '<span class="kw">#' + esc(kw) + '</span>';
      });
      html += '</div>';
      html += '<div class="r"><span class="stars">⭐ ' + it.s + '<span class="u">stars</span></span></div>';
      html += '</a>';
    });
    listEl.innerHTML = html;
  }
  renderList();
  renderBoard();

  // ---- live sync with xiaohai-78/Top data.json ----
  try {
    fetch(DATA.live, { cache: 'no-store' })
      .then(function (r) { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
      .then(function (live) {
        if (!live || !Array.isArray(live.repos)) throw new Error('bad payload');
        var map = {};
        live.repos.forEach(function (rp) { map[rp.name] = rp.starsCount; });
        var changed = false;
        all.forEach(function (it) {
          if (map[it.n] !== undefined && map[it.n] !== it.s) { it.s = map[it.n]; changed = true; }
        });
        if (changed) {
          totalStars = all.reduce(function (n, it) { return n + it.s; }, 0);
          renderStats(true);
          renderList();
          renderBoard();
        } else {
          renderStats(true);
        }
      })
      .catch(function () { /* offline: keep snapshot */ });
  } catch (e) { /* fetch unavailable */ }
})();
</script>
</body>
</html>
